/// Datei in Supabase Storage mit fachlicher Zuordnung und Sichtbarkeit.
model FileAsset {
  id             String    @id @default(cuid())
  organizationId String
  scope          FileScope @default(OTHER)

  bucket    String  @default("clenaris")
  path      String // Supabase Storage Pfad
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  checksum  String?
  /// true = öffentlich lesbar, false = nur via Signed URL
  isPublic  Boolean @default(false)

  bookingId     String?
  quoteId       String?
  invoiceId     String?
  jobId         String?
  customerId    String?
  employeeId    String?
  propertyId    String?
  expenseId     String?
  messageId     String?
  applicationId String?

  uploadedById String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  quote        Quote?          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  job          Job?            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employee     Employee?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  property     Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  expense      Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  message      Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  application  JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId, scope])
  @@index([bookingId])
  @@index([jobId])
  @@map("file_assets")
}

// ---------------------------------------------------------------------------
//  Handlungsaufrufe (Call to Action)
// ---------------------------------------------------------------------------

/// Wo auf der Website ein Handlungsaufruf erscheint.
///
/// Der Platz ist kein freier Text, sondern eine feste Liste: jede Stelle muss
/// im Layout tatsächlich gerendert werden, und ein Tippfehler wäre sonst eine
/// Schaltfläche, die gespeichert wird und nie erscheint.
enum CtaSlot {
  /// Rechts in der Kopfzeile, neben Anrufen.
  HEADER
  /// Hauptschaltfläche im Kopfbereich einer Seite.
  HERO_PRIMARY
  /// Zweite, ruhigere Schaltfläche daneben.
  HERO_SECONDARY
  /// Abschlussband zwischen zwei Abschnitten.
  SECTION_BANNER
  /// In der Fusszeile.
  FOOTER
  /// Fest am unteren Rand auf dem Telefon.
  MOBILE_BAR
}

/// Erscheinungsbild. Entspricht den Varianten des Schaltflächen-Bausteins;
/// CUSTOM erlaubt eigene Farben.
enum CtaStyle {
  PRIMARY
  SECONDARY
  OUTLINE
  GHOST
  ACCENT
  SUCCESS
  CUSTOM
}

model CallToAction {
  id             String @id @default(cuid())
  organizationId String

  /// Stabiler Kurzname, erscheint nicht öffentlich. Dient dem Wiederfinden
  /// und der Auswertung („welcher Aufruf wurde wie oft geklickt").
  key   String
  /// Beschriftung auf der Schaltfläche.
  label String
  /// Interne Notiz — wofür der Aufruf gedacht ist.
  note  String?

  /// Ziel. Interner Pfad (/offerte), externe Adresse, tel: oder mailto:.
  href   String
  /// true = in neuem Tab öffnen. Bei tel: und mailto: ohne Wirkung.
  newTab Boolean @default(false)
  /// Name eines Lucide-Symbols, etwa `Phone` oder `MessageCircle`.
  icon   String?

  slot    CtaSlot
  style   CtaStyle @default(PRIMARY)
  /// Eigene Farben, nur bei style = CUSTOM ausgewertet.
  bgColor String?
  fgColor String?

  /// Auf welchen Seiten der Aufruf erscheint. Leere Liste = auf allen.
  /// Pfade wie `/`, `/leistungen`, `/leistungen/*`.
  pages String[] @default([])

  active   Boolean @default(true)
  position Int     @default(0)

  /// Zeitsteuerung. Beide leer = sofort und unbefristet.
  publishFrom  DateTime? @db.Timestamptz(6)
  publishUntil DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Nicht endgültig gelöscht, sondern in den Papierkorb gelegt.
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, slot, active])
  @@map("calls_to_action")
}

// ---------------------------------------------------------------------------
//  Navigation und Rechtstexte
// ---------------------------------------------------------------------------

/// Wo ein Menüpunkt erscheint.
enum NavLocation {
  /// Oberste Ebene der Kopfzeile.
  HEADER
  /// Aufklappbereich unter einem Kopfzeilen-Eintrag.
  HEADER_PANEL
  /// Fusszeile, Spalte „Leistungen".
  FOOTER_SERVICES
  /// Fusszeile, Spalte „Unternehmen".
  FOOTER_COMPANY
  /// Fusszeile, Zeile mit den Rechtstexten.
  FOOTER_LEGAL
}

model NavigationItem {
  id             String      @id @default(cuid())
  organizationId String
  location       NavLocation

  label       String
  href        String
  /// Zweite Zeile im Aufklappbereich — erklärt, wohin der Punkt führt.
  description String?
  /// Name eines Lucide-Symbols.
  icon        String?
  newTab      Boolean @default(false)

  /// Übergeordneter Punkt für Aufklappbereiche. Null = oberste Ebene.
  parentId String?

  position Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationItem[] @relation("NavChildren")

  @@index([organizationId, location, active])
  @@map("navigation_items")
}

/// Impressum, Datenschutzerklärung, AGB, Cookie-Hinweis.
///
/// Eigenes Modell statt Textbaustein: Rechtstexte tragen eine Fassung und ein
/// Inkrafttreten. Wer wissen will, welchen AGB eine Kundschaft im März
/// zugestimmt hat, braucht genau diese beiden Angaben — ein überschriebener
/// Textbaustein kann sie nicht liefern.
model LegalDocument {
  id             String @id @default(cuid())
  organizationId String

  slug  String
  title String
  /// Markdown. Wird über denselben Baustein gerendert wie die Blogbeiträge.
  body  String

  /// Zählt bei jeder inhaltlichen Änderung hoch.
  version       Int      @default(1)
  effectiveFrom DateTime @default(now()) @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@map("legal_documents")
}
