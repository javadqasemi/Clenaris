/// Redaktionell pflegbarer Inhaltsbaustein der Website.
///
/// Architekturentscheid: ein Schlüssel-Wert-Speicher statt einer Tabelle je
/// Seite. Welche Schlüssel es gibt, welchen Typ sie haben und welcher Text
/// gilt, solange nichts gepflegt wurde, steht als Register im Code
/// (`lib/cms/registry.ts`). Daraus folgt dreierlei: die Redaktionsmaske
/// erzeugt sich selbst, ein Tippfehler im Schlüssel ist ein Übersetzungs-
/// fehler statt einer leeren Seite, und eine fehlende Zeile lässt die Website
/// nicht zusammenbrechen — sie zeigt den hinterlegten Standardtext.
model ContentBlock {
  id             String @id @default(cuid())
  organizationId String
  /// Stabiler Schlüssel aus dem Register, etwa `home.hero.title`.
  key            String
  locale         Locale @default(DE)
  /// Der **veröffentlichte** Wert — was Besucherinnen und Besucher sehen.
  value          Json

  /// Unveröffentlichter Entwurf.
  ///
  /// `null` heisst „kein offener Entwurf": veröffentlichter Stand und
  /// Bearbeitungsstand sind identisch. Getrennt von `value` und nicht als
  /// Statusfeld am selben Wert, weil beide Fassungen gleichzeitig gebraucht
  /// werden — die Website liest `value`, die Vorschau `draftValue`.
  draftValue Json?

  /// Wann dieser Baustein zuletzt veröffentlicht wurde.
  publishedAt DateTime? @db.Timestamptz(6)

  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  revisions    ContentRevision[]

  @@unique([organizationId, key, locale])
  /// Deckt auch die Frage „gibt es offene Entwürfe?" ab: Die Tabelle umfasst
  /// wenige hundert Zeilen, ein eigener Index auf ein JSON-Feld brächte dort
  /// nichts ausser Schreibkosten.
  @@index([organizationId, locale])
  @@map("content_blocks")
}

/// Eingebauter Dateispeicher — die Rückfallebene, wenn kein externer
/// Objektspeicher eingerichtet ist.
///
/// **Warum es das gibt.** Die Anwendung lädt Dateien normalerweise am Server
/// vorbei direkt zu Supabase Storage. Das ist der bessere Weg: Es umgeht das
/// Body-Limit serverloser Funktionen und spart Bandbreite. Ohne eingerichteten
/// Speicher schlug aber *jeder* Upload fehl — Profilbild, Einsatzfotos,
/// Galerie, Bewerbungsunterlagen —, und zwar mit der irreführenden Meldung, ein
/// externer Dienst sei „derzeit nicht erreichbar".
///
/// **Warum in der Datenbank und nicht auf der Festplatte.** Eine Datei auf dem
/// Dateisystem überlebt weder einen serverlosen Neustart noch einen zweiten
/// Container. Die Datenbank ist der einzige Ort, den diese Anwendung in jeder
/// Betriebsart als dauerhaft voraussetzen darf.
///
/// **Was das kostet.** Binärdaten liegen in den Sicherungen der Datenbank und
/// blähen sie auf. Deshalb ist die Rückfallebene bewusst auf kleine Dateien
/// begrenzt (siehe `LOCAL_MAX_BYTES`) und trägt in jeder Fehlermeldung den
/// Hinweis auf den externen Speicher. Sie ist die Zusicherung, dass nichts
/// kaputt ist — nicht die empfohlene Betriebsart.
model StoredFile {
  id             String @id @default(cuid())
  organizationId String

  /// Derselbe logische Pfad wie beim externen Speicher — erleichtert eine
  /// spätere Übernahme der Dateien.
  path      String
  mimeType  String
  sizeBytes Int    @default(0)
  /// Obergrenze aus dem Upload-Profil, beim Anlegen festgehalten.
  maxBytes  Int

  /// `null`, solange der Upload noch aussteht.
  data Bytes?

  uploadedById String?
  uploadedAt   DateTime? @db.Timestamptz(6)
  /// Bis wann der Platzhalter beschrieben werden darf.
  expiresAt    DateTime  @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  /// Für das Aufräumen nie beschriebener Platzhalter.
  @@index([expiresAt])
  @@map("stored_files")
}

/// Frühere Fassung eines Textbausteins.
///
/// Geschrieben wird beim **Veröffentlichen**, und zwar der Wert, der dadurch
/// ersetzt wird. Damit enthält die Historie ausschliesslich Stände, die
/// tatsächlich einmal öffentlich waren — Zwischenstände eines Entwurfs sind
/// keine Fassung, sondern Tippen.
///
/// Bewusst eine eigene Tabelle statt eines JSON-Feldes am Baustein: Sie wächst
/// unbegrenzt, und ein wachsendes Feld an einem Datensatz, der bei *jedem*
/// Seitenaufruf gelesen wird, verlangsamt genau den Pfad, der schnell sein muss.
model ContentRevision {
  id             String @id @default(cuid())
  organizationId String
  blockId        String

  key    String
  locale Locale @default(DE)
  /// Die ersetzte Fassung, in derselben Form wie `ContentBlock.value`.
  value  Json

  /// Wer veröffentlicht hat — für die Zeile „ersetzt von … am …".
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  block        ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  /// Die Historie wird je Baustein und in umgekehrter Zeitfolge gelesen.
  @@index([blockId, createdAt])
  @@index([organizationId, createdAt])
  @@map("content_revisions")
}

/// Suchmaschinen-Angaben je Seitenpfad.
///
/// Getrennt von `ContentBlock`, weil sie an einer *Route* hängen und nicht an
/// einem Textbaustein — und weil `noIndex` eine technische Schaltung ist, die
/// versehentlich gesetzt eine Seite aus dem Index wirft.
model SeoMeta {
  id             String @id @default(cuid())
  organizationId String
  /// Pfad ohne Domain, etwa `/leistungen` oder `/` für die Startseite.
  path           String
  locale         Locale @default(DE)

  title       String?
  description String?
  keywords    String[] @default([])
  ogImageUrl  String?
  noIndex     Boolean  @default(false)

  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, path, locale])
  @@map("seo_meta")
}

