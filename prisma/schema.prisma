// ===========================================================================
//  Clenaris — Prisma Schema
//  PostgreSQL (Supabase). Geldbeträge: Decimal(12,2) in CHF.
//  Zeitstempel: immer UTC (timestamptz), Formatierung in der UI (Europe/Zurich).
//
//  Architekturentscheide:
//  1) Organization als Mandanten-Wurzel: die Plattform startet single-tenant,
//     ist aber ohne Migration mandantenfähig. Jede Top-Level-Aggregatwurzel
//     trägt `organizationId`.
//  2) Soft-Deletes (`deletedAt`) nur dort, wo Geschäftsdaten revisionssicher
//     bleiben müssen (Kunden, Rechnungen, Offerten, Jobs). Alles andere wird
//     hart gelöscht — DSG/DSGVO-Löschbegehren bleiben so umsetzbar.
//  3) Finanzdokumente (Invoice, Quote, CreditNote) sind append-only: ausgestellte
//     Dokumente werden nie mutiert, Korrekturen laufen über Gutschriften.
//  4) Jede sicherheitsrelevante Mutation landet im AuditLog.
// ===========================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

