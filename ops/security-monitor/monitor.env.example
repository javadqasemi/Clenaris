# Konfiguration des externen Überwachungsrechners für Clenaris.
#
# VORLAGE — nicht eingerichtet, nicht ausgeliefert. Kopieren nach
# /etc/clenaris-monitor/monitor.env, Besitzer root:clenaris-monitor, Rechte 0640.
# Geheimnisse stehen NUR hier (Umgebung), nie in Befehlszeilen, nie im Repository.
#
# Dieser Rechner ist NICHT der Anwendungsserver und NICHT 2.29.18.45.

# --- Ziel ------------------------------------------------------------------
# Nur https. Der Gesundheitsendpunkt ist öffentlich und enthält keine Geheimnisse.
MONITOR_ZIEL="https://clenaris.qasemi.ch"
MONITOR_HEALTH_PFAD="/api/health"
# Höchstens 2 Anfragen pro Sekunde — die Skripte warten zwischen zwei Anfragen
# mindestens so lange (Sekunden, Dezimalpunkt erlaubt).
MONITOR_PAUSE_S="0.5"
# Zeitlimit je Anfrage (Sekunden).
MONITOR_ZEITLIMIT_S="10"
# Warnen, wenn das TLS-Zertifikat in weniger als so vielen Tagen abläuft.
MONITOR_TLS_WARN_TAGE="21"
MONITOR_TLS_KRITISCH_TAGE="7"

# --- Bericht an die Sicherheitszentrale -------------------------------------
# Eigenes Geheimnis der Anwendung (SECURITY_REPORT_TOKEN), NICHT CRON_SECRET.
# Leer lassen, um nicht zu melden.
SECURITY_REPORT_URL="https://clenaris.qasemi.ch/api/cron/security-report"
SECURITY_REPORT_TOKEN=""

# --- Alarmierung (alert.sh) -------------------------------------------------
# Webhook (z. B. Slack, Teams, Matrix-Brücke) — nur https. Leer = kein Webhook.
ALERT_WEBHOOK_URL=""
# E-Mail über ein lokal eingerichtetes `mail`/`sendmail`. Leer = keine E-Mail.
ALERT_MAIL_AN=""
# Gleicher Alarm höchstens alle N Minuten (Entdoppelung). Eine höhere Schwere
# geht immer sofort durch.
ALERT_WIEDERHOLEN_MIN="60"
# Arbeitsverzeichnis für Zustand und Protokoll.
MONITOR_ZUSTAND="/var/lib/clenaris-monitor"
MONITOR_PROTOKOLL="/var/log/clenaris-monitor"

# --- ZAP-Grundprüfung (zap_baseline.sh) -------------------------------------
# Nur passiv. Container-Abbild der ZAP-Stable-Version, fest gepinnt nach Prüfung.
ZAP_ABBILD="ghcr.io/zaproxy/zaproxy:stable"
# Höchste Laufzeit des Spiders in Minuten (Baseline: passiv, nur Erkunden).
ZAP_SPIDER_MIN="2"

# --- Server-Prüfung (deps_check.sh, läuft auf dem ANWENDUNGSSERVER) ----------
# Verzeichnis der ausgelieferten Anwendung (nur gelesen).
APP_VERZEICHNIS="/srv/clenaris/current"
# Verzeichnis der Datenbanksicherungen (nur gelesen: Alter der neuesten).
BACKUP_VERZEICHNIS="/srv/clenaris/backups"
BACKUP_WARN_STUNDEN="26"
