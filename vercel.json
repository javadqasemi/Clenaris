{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/hourly",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "src/app/api/**/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
