# ============================================================================
# Clenaris — Umgebungsvariablen
# Kopiere diese Datei nach `.env` und fülle die Werte aus.
# ============================================================================

# --- Applikation --------------------------------------------------------
NODE_ENV=development
# Herkunft DIESER Instanz — zur LAUFZEIT gelesen (Links, Mails, Zahlungen,
# Signaturen, Herkunftsprüfung). Nur Schema, Host, Port. In Produktion Pflicht.
APP_URL=http://localhost:3000
# Kanonische Domain der öffentlichen Website — zur BAUZEIT eingesetzt
# (statische Seiten, Sitemap, robots, JSON-LD). Ein Wert für alle Umgebungen,
# Begründung in src/lib/seiten-url.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Älterer Name. Wird noch als Rückfall für beide oben gelesen; neu nicht mehr setzen.
# NEXT_PUBLIC_APP_URL=

# --- Datenbank (Supabase / PostgreSQL) ----------------------------------
# Pooled Connection (PgBouncer, Port 6543) für die Applikation
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct Connection (Port 5432) für Migrationen
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Redis (Upstash / Redis Cloud) --------------------------------------
REDIS_URL="rediss://default:PASSWORD@eu2-xxx.upstash.io:6379"

# --- Authentifizierung ---------------------------------------------------
# Mind. 32 Zeichen. Generieren: openssl rand -base64 48
JWT_SECRET="CHANGE_ME_min_32_zeichen_langer_zufallsstring_xxxxxxxx"
JWT_ACCESS_TTL=900              # Sekunden (15 min)
JWT_REFRESH_TTL=2592000         # Sekunden (30 Tage), absolute Obergrenze
SESSION_IDLE_TTL=900            # Sekunden ohne Aktivität bis zur Abmeldung (15 min)
SESSION_REMEMBER_IDLE_TTL=604800 # dasselbe mit „Angemeldet bleiben" (7 Tage), siehe docs/SITZUNG.md
AUTH_COOKIE_DOMAIN=

# --- Feldverschlüsselung -------------------------------------------------
# Schützt TOTP-Geheimnis, AHV-Nummer und Alarmcode gegen einen Datenbankabzug
# (AES-256-GCM, siehe src/lib/crypto.ts). Genau 64 Hex-Zeichen.
# Generieren: openssl rand -hex 32
#
# Fehlt der Wert, leitet die Anwendung den Schlüssel aus JWT_SECRET ab. Sie
# läuft dann — aber ein Wechsel von JWT_SECRET macht die verschlüsselten
# Felder unlesbar. Im Produktivbetrieb deshalb setzen.
ENCRYPTION_KEY=

# Welchem Proxy-Kopf die Client-Adresse entnommen wird (src/lib/http/client-ip.ts).
#   NONE                 — keinem; Adresse gilt als nicht verfügbar (sichere Vorgabe)
#   SINGLE_REVERSE_PROXY — genau ein Nginx davor, der X-Real-IP aus $remote_addr SETZT
#   CLOUDFLARE           — CF-Connecting-IP; nur wenn der Ursprung nicht direkt erreichbar ist
# Ein falscher Modus lässt gefälschte Adressen ins Prüf- und Signaturprotokoll.
TRUSTED_PROXY_MODE=NONE

# --- Supabase Storage ----------------------------------------------------
# Trotz des Präfixes nur serverseitig und zur Laufzeit gelesen.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECTREF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_STORAGE_BUCKET=clenaris

# --- Stripe --------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- TWINT (via Stripe Payment Method / Datatrans Fallback) -------------
TWINT_ENABLED=true
DATATRANS_MERCHANT_ID=
DATATRANS_PASSWORD=
DATATRANS_ENV=sandbox

# --- E-Mail (Resend) -----------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="Clenaris <noreply@clenaris.ch>"
EMAIL_REPLY_TO="info@clenaris.ch"
EMAIL_BCC_ARCHIVE=

# --- SMS (Twilio) --------------------------------------------------------
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+41xxxxxxxxx"
TWILIO_MESSAGING_SERVICE_SID=

# --- Google Maps ---------------------------------------------------------
# Browser-Schlüssel (auf die Domain beschränkt) — zur Laufzeit gelesen.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIza..."
GOOGLE_MAPS_SERVER_KEY="AIza..."

# --- KI (Anthropic Claude) ----------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL=claude-opus-5
AI_MODEL_FAST=claude-haiku-4-5

# --- Marketing / Analytics ----------------------------------------------
# Zur LAUFZEIT gelesen und dem Browser über /api/public/runtime-config
# gegeben (nur nach Einwilligung). Enge Formate: G-…, GTM-…, nur Ziffern.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
# Eigene Besuchsmessung (/admin/auswertungen/website). Nur der Wert „an"
# schaltet sie ein; leer oder alles andere heisst aus. In der Produktion aus,
# bis die Datenschutzerklärung rechtlich geprüft ist (TA-02) — die
# Produktionsvorprüfung warnt, wenn sie eingeschaltet ist. Auch eingeschaltet
# misst sie nur nach Einwilligung „Statistik" im Browser.
CLENARIS_BESUCHSMESSUNG=
# Zur BAUZEIT — bestätigt die kanonische Domain (src/lib/seiten-url.ts).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Cron / interne Jobs -------------------------------------------------
# Wird von Vercel Cron im Header `Authorization: Bearer <CRON_SECRET>` gesendet
CRON_SECRET="CHANGE_ME_random_string"
# Berichtseingang der Sicherheitszentrale (security:check --melden, externer
# Überwachungsrechner). Eigenes Geheimnis, mindestens 32 Zeichen, NICHT
# dasselbe wie CRON_SECRET. Leer = Eingang geschlossen.
SECURITY_REPORT_TOKEN=
# Release-Ausführer (deploy/v2/release-ausfuehrer.yml): Token öffnet die
# Schnittstelle, Signaturschlüssel beweist den Rumpf (HMAC, reist nie mit).
# Beide eigene Geheimnisse, je mindestens 32 Zeichen, nirgends sonst
# verwendet. Umgebung: production | staging | preview | test. Fehlt eines,
# nimmt die Schnittstelle nichts an.
# In der Produktion ist CLENARIS_UMGEBUNG=production Pflicht
# (npm run production:preflight). test/preview setzen ausschliesslich
# scripts/test-server.ts und scripts/preview-server.ts.
RELEASE_EXECUTOR_TOKEN=
RELEASE_EXECUTOR_SIGNING_KEY=
CLENARIS_UMGEBUNG=
# Erst setzen (Wert: bestaetigt), wenn die Hetzner-Firewall 80/443 nur noch für
# die Cloudflare-Bereiche öffnet UND der direkte Zugriff auf die IP von aussen
# als geschlossen geprüft ist. Ohne diese Bestätigung weist die
# Produktionsvorprüfung TRUSTED_PROXY_MODE=CLOUDFLARE ab.
CLENARIS_URSPRUNG_NUR_CLOUDFLARE=

# --- Firma (Default-Werte für Seed) -------------------------------------
COMPANY_NAME="Clenaris Reinigungen GmbH"
COMPANY_EMAIL="info@clenaris.ch"
COMPANY_PHONE="+41 31 000 00 00"
COMPANY_STREET="Bahnhofstrasse 1"
COMPANY_ZIP="3011"
COMPANY_CITY="Bern"
COMPANY_VAT_NUMBER="CHE-123.456.789 MWST"
COMPANY_IBAN="CH93 0076 2011 6238 5295 7"
COMPANY_QR_IBAN="CH44 3199 9123 0008 8901 2"

# --- Seed Admin ----------------------------------------------------------
# Startpasswörter der beiden Verwaltungskonten. Hier bewusst LEER: Ein Wert in
# dieser Datei steht in einem öffentlichen Repository und ist damit verbrannt.
#
#  • Wegwerf-Datenbank (Name enthält test/preview/demo) oder ALLOW_DEMO_SEED=ja,
#    ausserhalb der Produktion: leer lassen — der Seed nimmt die örtlichen
#    Demovorgaben (tests/helpers/accounts.ts).
#  • Jede andere Datenbank: eigene Werte, mindestens 12 Zeichen. Der Seed weist
#    fehlende, zu kurze und öffentlich bekannte Passwörter ab; ein
#    Produktionsbau weist sie auch bei der Anmeldung ab.
#    Erzeugen: openssl rand -base64 24
SEED_ADMIN_EMAIL="admin@clenaris.ch"
SEED_ADMIN_PASSWORD=
SEED_SUPERADMIN_EMAIL="system@clenaris.ch"
SEED_SUPERADMIN_PASSWORD=

# --- Auslieferung --------------------------------------------------------
# Keine Variable mehr (2026-09-30): Commit, Build-ID und Version liest die
# Instanz aus RELEASE.json und .next/BUILD_ID in ihrem eigenen Verzeichnis
# (src/lib/release/identitaet.ts) und meldet sie über GET /api/health. Das
# frühere APP_VERSION wird nicht mehr gelesen — eine Variable bewies nicht,
# welcher Code tatsächlich läuft.
