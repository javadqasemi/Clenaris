{
  "root": true,
  "extends": ["next/core-web-vitals", "next/typescript"],
  "ignorePatterns": [".next/", "node_modules/", "docs/", "prisma/migrations/"],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "@typescript-eslint/consistent-type-imports": [
      "warn",
      { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
    ],
    "no-console": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@prisma/client",
            "importNames": ["PrismaClient"],
            "message": "Bitte die geteilte Instanz aus '@/lib/db' verwenden — eine zweite Instanz erschöpft im Serverless-Betrieb den Verbindungspool."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["scripts/**/*.ts", "prisma/seed.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/lib/logger.ts", "src/app/error.tsx", "src/components/app/area-error.tsx"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/lib/db.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
